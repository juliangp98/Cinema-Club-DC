# Cinema Club DC — local development settings.
# Copy to backend/.env.development (the backend, the scraper and a local bot read it):
#   cp backend/.env.example backend/.env.development
# Everything is optional locally: sign-in links print to the backend console
# when SMTP isn't set. Every setting: docs/configuration.md.

SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite:///instance/cinemaclub_dev.db
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:5173
# The site's name, wherever it's said (default: Cinema Club DC)
SITE_NAME=

# A fresh database's first admin and default club (sign in with this address)
ADMIN_EMAIL=you@example.com
ADMIN_NAME=You

SMTP_EMAIL=
SMTP_PASSWORD=

# Film details
TMDB_API_TOKEN=
OMDB_API_KEY=

# AI: ✨ Ask in Help, ✨ search, the bot's chat (free key from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# AMC API (AMC theatre showtime access)
AMC_API_KEY=

# Discord bot — never run a local bot with the live server's token; make a
# separate test application (docs/discord-bot.md)
INTERNAL_API_TOKEN=local-dev-token
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DEFAULT_GROUP_ID=1
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Push alerts (python vapid_keys.py makes the pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

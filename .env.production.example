# Cinema Club DC — production settings (the backend and the Discord bot both read this file).
# Copy to .env.production at the repo root and fill in real values:
#   cp .env.production.example .env.production
# Every setting, with how to get it: docs/configuration.md. Never commit the real file.

# ─── Needed ───────────────────────────────────────────────────────────────────

# Signs sessions. Make one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The site's public address (email links, the secure cookie, CORS)
FRONTEND_URL=https://your-domain.example
SITE_URL=https://your-domain.example
# The site's name, wherever it's said — pages, emails, calendars, the bot (default: Cinema Club DC)
SITE_NAME=
# Sign-in links go by email: a Gmail address and an app password for it
SMTP_EMAIL=
SMTP_PASSWORD=
# A shared secret between the backend and the bot (make one like SECRET_KEY)
INTERNAL_API_TOKEN=
# Where the database lives inside the backend container (its Docker volume)
DATABASE_URL=sqlite:///cinemaclub.db

# First start of a fresh install only: the first admin account and the default club.
# (An existing database already has them; these can stay empty.)
ADMIN_EMAIL=
ADMIN_NAME=

# ─── Film details (recommended) ───────────────────────────────────────────────

# themoviedb.org → Settings → API → "API Read Access Token" (posters, cast, details)
TMDB_API_TOKEN=
# omdbapi.com (IMDb / Rotten Tomatoes / Metacritic ratings, awards)
OMDB_API_KEY=

# ─── Discord bot (docs/discord-bot.md) ────────────────────────────────────────

DISCORD_BOT_TOKEN=
# The channel for schedule drops, digests and game posts
DISCORD_CHANNEL_ID=
# The club the Discord server belongs to (1 on a fresh install)
DEFAULT_GROUP_ID=1
# Optional "Sign in with Discord" — same application, OAuth2 tab. Register the
# redirect https://your-domain.example/api/auth/discord/callback there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── AI (optional) ────────────────────────────────────────────────────────────

# Free key from console.groq.com: ✨ Ask in Help, ✨ search, the bot's chat
GROQ_API_KEY=
# Optional model pins; chosen automatically from Groq's catalogue when blank
# ("none" disables the fallback). Admins can also change them with /llm.
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# ─── Push alerts (optional) ───────────────────────────────────────────────────

# Make the pair once with
#   docker exec cinemaclub-backend python vapid_keys.py
# and paste both lines here (keep the private key secret).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── More theatres (optional) ─────────────────────────────────────────────────

# AMC's developer API key (developers.amctheatres.com). The AMC theatres switch
# on by themselves once AMC has authorized it (each full scrape run checks).
AMC_API_KEY=

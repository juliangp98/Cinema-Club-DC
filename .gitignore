.DS_Store
backend/venv/
__pycache__/
*.pyc
node_modules/

# Secrets — never commit real values
.env
.env.production
.env.development
backend/.env
backend/.env.production
backend/.env.development

# Safe templates (committed)
!.env.production.example
!backend/.env.example

backend/instance/cinemaclub_dev.db

# Build output (Docker builds the frontend from source)
frontend/dist/

# Automatic pre-migration database backups
backend/instance/*.bak

# R6b: uploaded pictures (dev)
backend/instance/media/

# Test environment (tests/run.sh makes it)
tests/.venv/
.pytest_cache/

# Databases and local notes never go in the repo (it's public): the app's own
# databases live on the server / your machine. The test fixture (fake data) is
# the exception.
*.db
!tests/fixtures/base.db
*.db.*.bak
.claude/settings.local.json
.claude/memory/CONVERSATION_LOG.md
*.db-shm
*.db-wal
backend/instance/

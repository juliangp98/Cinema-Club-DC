FROM python:3.12-slim

# The club's clock: showtimes are stored as the theatres' wall-clock times and
# compared with datetime.now(), so the container must run on DC time (the
# image's default is UTC, which made tonight's shows look started at 4 PM).
ENV TZ=America/New_York

WORKDIR /app

# Install system deps for lxml (used by BeautifulSoup)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libxml2-dev libxslt1-dev && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .
# The Help guide (7f): one copy, the site's — help_ai.py answers ✨ Ask from it.
COPY frontend/src/help.json help.json

# Ensure instance directory exists for SQLite
RUN mkdir -p /app/instance

EXPOSE 5001

ENTRYPOINT ["bash", "entrypoint.sh"]
